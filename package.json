{
  "name": "hayasinth-portfolio",
  "version": "1.0.0",
  "description": "Personal Portfolio website for Hayasinth M (Computer Science Engineer & Full Stack Developer)",
  "main": "server/server.js",
  "scripts": {
    "start": "node server/server.js",
    "server": "node server/server.js",
    "client": "npm run dev --prefix client",
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "build": "npm run build --prefix client",
    "postinstall": "cd client && npm install"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "sqlite3": "^5.1.7"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  },
  "keywords": [
    "portfolio",
    "react",
    "express",
    "sqlite",
    "python",
    "javascript",
    "fullstack"
  ],
  "author": "Hayasinth M",
  "license": "MIT"
}
